# Copy to .env.local for development. On Railway, set these as service variables
# (they are read at build time, so redeploy after changing them).

# Required. Full origin, no trailing slash. The build fails if this is missing.
# Domain not bought yet (decision D1), so this is a placeholder.
SITE_URL=https://theaibusinesskit.com

# Optional. Defaults to "The AI Business Kit".
SITE_NAME=The AI Business Kit

# Used by POST /api/subscribe (Tomas, not built yet). Server-only.
# KIT_API_KEY=
# KIT_FORM_ID=
